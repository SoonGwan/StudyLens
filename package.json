{
  "name": "studylens",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:helper": "bun scripts/build-helper.mjs",
